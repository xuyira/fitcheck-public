DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"
COOKIE_SECURE="false"

DASHSCOPE_API_KEY=""
TRY_ON_PROVIDER="qwen-image"
QWEN_IMAGE_MODEL="qwen-image-3.0-pro"
# 可选：使用业务空间专属域名时填写 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/api/v1"

# 保留的百炼 AI Try-on 对比接口：将 TRY_ON_PROVIDER 改为 bailian 后启用
DASHSCOPE_MODEL="aitryon-plus"

# ModelFlare GPT Image 2：将 TRY_ON_PROVIDER 改为 modelflare 后启用
MODELFLARE_API_KEY=""
MODELFLARE_API_BASE="https://origin.modelflare.dev/v1"
MODELFLARE_IMAGE_MODEL="gpt-image-2"
MODELFLARE_IMAGE_QUALITY="high"

# 可选 OpenAI-compatible 图像编辑对比接口：TRY_ON_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.aicodewith.ai/chatgpt/v1"
OPENAI_IMAGE_MODEL="gpt-image-2"

ALIYUN_OSS_REGION="oss-cn-beijing"
ALIYUN_OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
ALIYUN_OSS_BUCKET=""
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
